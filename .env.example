# Database Configuration (PostgreSQL / Vercel Postgres / Neon / Supabase / Prisma Postgres)
#
# 1. Standard / Pooled Connection (Used for queries by Prisma Client & db.ts):
#    - For Vercel Postgres: automatically set as POSTGRES_PRISMA_URL or copy into DATABASE_URL.
#    - Must include ?pgbouncer=true if using PgBouncer/transaction pooler (handled automatically by db.ts).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/preone

# 2. Direct Connection (Used for Prisma migrations & schema pushes):
#    - For Vercel Postgres: set from POSTGRES_URL_NON_POOLING.
#    - For local dev: set to the same as DATABASE_URL.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/preone

# Vercel Postgres auto-injected environment variables (recognized automatically by db.ts & db-env.js):
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_URL=
# PREONE_PG_URL=

# Required – shared secret for JWT signing (set to a long random string)
JWT_SECRET=

# Optional – Node environment (Vercel sets this automatically; do not set manually)
NODE_ENV=

# Production-Gating & Authentication (BUG-029)
# In production (NODE_ENV=production), fixed demo OTP codes ('0000', '1234') are STRICTLY GATED OFF by default.
# Only set to 'true' in isolated non-production demo/staging environments when demo bypass is explicitly required.
# Default in production: false (gated OFF). Default in development/test: true.
ENABLE_DEMO_OTP=false
ALLOW_DEMO_OTP=false

# Optional – email provider
SMTP_HOST=
SENDGRID_API_KEY=

# Optional – SMS provider
SMS_API_KEY=
TWILIO_AUTH_TOKEN=

# Optional – WhatsApp provider
WHATSAPP_API_TOKEN=

# AWS S3 Object Storage (Zero binaries in Git or local filesystem in production)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
CDN_BASE_URL=
