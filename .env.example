# Required – PostgreSQL connection string for Prisma
DATABASE_URL=

# Optional alias – same value as DATABASE_URL (used by db.ts)
PREONE_PG_URL=

# Required – shared secret for JWT signing (set to a long random string)
JWT_SECRET=

# Optional – Node environment (Vercel sets this automatically; do not set manually)
NODE_ENV=

# Optional – email provider
SMTP_HOST=
SENDGRID_API_KEY=

# Optional – SMS provider
SMS_API_KEY=
TWILIO_AUTH_TOKEN=

# Optional – WhatsApp provider
WHATSAPP_API_TOKEN=
