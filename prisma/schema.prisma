model Curriculum {
  id                String                   @id @default(uuid())
  tenantId          String
  academicSessionId String?
  programId         String?
  programType       ProgramType?
  name              String
  description       String?
  framework         String                   @default("EYFS")
  version           Int                      @default(1)
  status            CurriculumStatus         @default(ACTIVE)
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  deletedAt         DateTime?
  academicSession   AcademicSession?         @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  program           Program?                 @relation(fields: [programId], references: [id], onDelete: SetNull)
  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  learningAreas     CurriculumLearningArea[]
  activities        ClassroomActivity[]

  @@index([tenantId, academicSessionId])
  @@index([tenantId, programId])
  @@map("curriculums")
}

model CurriculumLearningArea {
  id            String         @id @default(uuid())
  tenantId      String
  curriculumId  String
  name          String
  code          String?
  description   String?
  displayOrder  Int            @default(0)
  status        String         @default("ACTIVE")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  curriculum    Curriculum     @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  goals         LearningGoal[]

  @@index([tenantId, curriculumId])
  @@map("curriculum_learning_areas")
}

model LearningGoal {
  id                       String                 @id @default(uuid())
  tenantId                 String
  curriculumLearningAreaId String
  name                     String
  description              String?
  ageMinMonths             Int?
  ageMaxMonths             Int?
  displayOrder             Int                    @default(0)
  status                   String                 @default("ACTIVE")
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  deletedAt                DateTime?
  learningArea             CurriculumLearningArea @relation(fields: [curriculumLearningAreaId], references: [id], onDelete: Cascade)
  tenant                   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activities               ClassroomActivity[]
  observations             Observation[]
  progressRecords          StudentProgress[]

  @@index([tenantId, curriculumLearningAreaId])
  @@map("learning_goals")
}

model ClassroomActivity {
  id                String          @id @default(uuid())
  tenantId          String
  academicSessionId String
  classroomId       String
  curriculumId      String?
  learningGoalId    String?
  teacherId         String?
  title             String
  description       String?
  activityDate      DateTime
  startTime         String?
  endTime           String?
  durationMinutes   Int             @default(30)
  materials         String?
  instructions      String?
  expectedOutcome   String?
  actualOutcome     String?
  status            ActivityStatus  @default(PLANNED)
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  classroom         Classroom       @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  curriculum        Curriculum?     @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  learningGoal      LearningGoal?   @relation(fields: [learningGoalId], references: [id], onDelete: SetNull)
  teacher           User?           @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  observations      Observation[]

  @@index([tenantId, academicSessionId, classroomId])
  @@index([activityDate])
  @@map("classroom_activities")
}

model StudentProgress {
  id                String          @id @default(uuid())
  tenantId          String
  academicSessionId String
  studentId         String
  learningGoalId    String
  stage             ProgressStage   @default(NOT_STARTED)
  notes             String?
  evidence          String?
  assessedBy        String?
  assessedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  assessedByUser    User?           @relation(fields: [assessedBy], references: [id], onDelete: SetNull)
  learningGoal      LearningGoal    @relation(fields: [learningGoalId], references: [id], onDelete: Cascade)
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, academicSessionId, studentId, learningGoalId])
  @@index([tenantId, studentId])
  @@index([tenantId, academicSessionId])
  @@map("student_progress")
}
